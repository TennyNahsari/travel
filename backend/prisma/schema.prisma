// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  DRIVER
  CUSTOMER
}

enum BookingStatus {
  PENDING
  PAID
  CONFIRMED
  CANCELLED
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  OFF_DUTY
  INACTIVE
}

enum RecurringType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings  Booking[]
  driver    Driver?
  charters  Charter[]
  packages  PackageBooking[]

  @@map("users")
}

model City {
  id          String   @id @default(uuid())
  name        String
  province    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  routesFrom        Route[]   @relation("RouteOrigin")
  routesTo          Route[]   @relation("RouteDestination")
  chartersFrom      Charter[] @relation("CharterOrigin")
  chartersTo        Charter[] @relation("CharterDestination")

  @@map("cities")
}

model Route {
  id              String   @id @default(uuid())
  originCityId    String
  destinationCityId String
  distance        Int      // in kilometers
  estimatedTime   Int      // in minutes
  basePrice       Int      // in rupiah
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  originCity      City     @relation("RouteOrigin", fields: [originCityId], references: [id])
  destinationCity City     @relation("RouteDestination", fields: [destinationCityId], references: [id])
  schedules       Schedule[]

  @@map("routes")
}

model SeatTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  rowsConfig  Json     // Array of seats per row, e.g., [2, 2, 2, 2, 2, 2]
  totalSeats  Int
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vehicles    Vehicle[]

  @@map("seat_templates")
}

model Vehicle {
  id             String        @id @default(uuid())
  plateNumber    String        @unique
  vehicleType    String
  capacity       Int
  seatTemplateId String?
  description    String?
  facilities     Json?
  imageUrl       String?
  maxCharter       Int           @default(0)
  charterPrice     Int           @default(0)
  maxPackageCount  Int           @default(0)
  maxPackageWeight Int           @default(0)
  packagePricePerKg Int          @default(0)
  status           VehicleStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  seatTemplate   SeatTemplate?  @relation(fields: [seatTemplateId], references: [id])
  schedules      Schedule[]
  charters       Charter[]

  @@map("vehicles")
}

model Driver {
  id        String       @id @default(uuid())
  userId    String       @unique
  licenseNumber String   @unique
  status    DriverStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  user      User         @relation(fields: [userId], references: [id])
  schedules Schedule[]

  @@map("drivers")
}

model Schedule {
  id              String         @id @default(uuid())
  routeId         String
  vehicleId       String
  driverId        String
  departureDate   DateTime
  departureTime   String
  ticketPrice     Int
  availableSeats  Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Template & Recurring fields
  isTemplate      Boolean        @default(false)
  recurringType   RecurringType  @default(NONE)
  recurringDays   Json?          // [0,1,2,3,4,5,6] for Sunday-Saturday
  templateName    String?
  isActive        Boolean        @default(true)
  sourceTemplateId String?

  // Pool & Image fields
  poolOrigin       String?
  poolDestination  String?
  imageUrl         String?

  // Status & Operational Timestamps
  status               ScheduleStatus @default(SCHEDULED)
  actualDepartureTime  DateTime?
  actualArrivalTime    DateTime?

  // Relations
  route           Route          @relation(fields: [routeId], references: [id])
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id])
  driver          Driver         @relation(fields: [driverId], references: [id])
  bookings        Booking[]
  packages        PackageBooking[]
  sourceTemplate  Schedule?      @relation("TemplateSchedules", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  generatedSchedules Schedule[]  @relation("TemplateSchedules")

  @@map("schedules")
}

model Booking {
  id                String        @id @default(uuid())
  bookingCode       String        @unique
  userId            String
  scheduleId        String
  seatNumbers       String[]      // Array of seat numbers
  totalSeats        Int
  totalPrice        Int
  status            BookingStatus @default(PENDING)
  paymentMethod     String?
  paidAt            DateTime?
  paymentDeadline   DateTime?
  passengerName     String?       // Nama Customer / Penumpang
  passengerPhone    String?       // No WhatsApp / HP
  passengerEmail    String?       // Email Penumpang
  passengerNik      String?       // No KTP / NIK
  checkedIn         Boolean       @default(false)
  checkInTime       DateTime?
  checkInBy         String?       // User ID who performed check-in

  // Payment Proof Fields
  paymentProofUrl   String?       // URL / Foto Bukti Transfer
  paymentSenderName String?       // Nama Pengirim / Pemilik Rekening
  paymentBankName   String?       // Bank Asal Pengirim (misal: BCA)
  paymentTargetBank String?       // Bank Tujuan Transfer
  paymentAmount     Int?          // Jumlah yang ditransfer (Rp)
  paymentNotes      String?       // Catatan konfirmasi pembayaran

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  user              User          @relation(fields: [userId], references: [id])
  schedule          Schedule      @relation(fields: [scheduleId], references: [id])

  @@map("bookings")
}

enum ScheduleStatus {
  SCHEDULED
  DEPARTED
  COMPLETED
  CANCELLED
}

model QrisSetting {
  id          String   @id @default(uuid())
  accountName String?  @default("PT Travel Shuttle Indonesia")
  imageUrl    String?
  instruction String?  @default("Scan QR Code QRIS di bawah menggunakan mobile banking atau e-wallet (GoPay/OVO/Dana/ShopeePay)")
  bankBca     String?  @default("123-456-7890 (a.n. PT Travel Shuttle Indonesia)")
  bankMandiri String?  @default("987-000-112233 (a.n. PT Travel Shuttle Indonesia)")
  bankOther   String?
  waNumber    String?  @default("6281234567890")
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("qris_settings")
}

model SocialSetting {
  id           String   @id @default(uuid())
  instagramUrl String?  @default("https://instagram.com")
  twitterUrl   String?  @default("https://twitter.com")
  youtubeUrl   String?  @default("https://youtube.com")
  facebookUrl  String?  @default("https://facebook.com")
  linkedinUrl  String?  @default("https://linkedin.com")
  threadsUrl   String?  @default("https://threads.net")
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("social_settings")
}

enum CharterStatus {
  PENDING
  PAID
  PROCESSED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Charter {
  id                 String        @id @default(uuid())
  charterCode        String        @unique
  userId             String?
  vehicleId          String
  originCityId       String?
  destinationCityId  String?
  originAddress      String
  destinationAddress String
  charterDate        DateTime
  durationDays       Int           @default(1)
  totalVehicles      Int           @default(1)
  totalPrice         Int
  status             CharterStatus @default(PENDING)

  customerName       String
  customerPhone      String
  customerEmail      String?
  notes              String?

  paymentMethod      String?
  paidAt             DateTime?
  paymentDeadline    DateTime?
  paymentProofUrl    String?
  paymentSenderName  String?
  paymentBankName    String?
  paymentTargetBank  String?
  paymentAmount      Int?
  paymentNotes       String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user               User?         @relation(fields: [userId], references: [id])
  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id])
  originCity         City?         @relation("CharterOrigin", fields: [originCityId], references: [id])
  destinationCity    City?         @relation("CharterDestination", fields: [destinationCityId], references: [id])

  @@map("charters")
}

enum PackageStatus {
  PENDING
  PAID
  PROCESSED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model PackageBooking {
  id                 String        @id @default(uuid())
  packageCode        String        @unique
  scheduleId         String
  userId             String?

  senderName         String
  senderPhone        String
  senderAddress      String?

  recipientName      String
  recipientPhone     String
  recipientAddress   String

  packageDescription String
  itemCount          Int           @default(1)
  weightKg           Int           @default(1)
  totalPrice         Int
  status             PackageStatus @default(PENDING)

  paymentMethod      String?
  paidAt             DateTime?
  paymentDeadline    DateTime?
  paymentProofUrl    String?
  paymentSenderName  String?
  paymentBankName    String?
  paymentTargetBank  String?
  paymentAmount      Int?
  paymentNotes       String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user               User?         @relation(fields: [userId], references: [id])
  schedule           Schedule      @relation(fields: [scheduleId], references: [id])

  @@map("package_bookings")
}



